# --- Servidor (Render usa PORT automático) ---
PORT=3001

# ---------------------------------------------------------------------------
# Correo (obligatorio para el webhook: envío del ZIP al técnico/supervisor)
#
# Resend – sin verificar dominio (solo estas dos variables):
# ---------------------------------------------------------------------------
# 1. https://resend.com → API Keys → Create API Key → copiar (re_xxxx)
# 2. REPORT_EMAIL_TO = el email de tu cuenta Resend (en modo prueba solo llega ahí)
# El remitente es siempre onboarding@resend.dev. REPORT_EMAIL_FROM se ignora con Resend.
# Opcional: un destinatario más (recibe el mismo correo).
# REPORT_EMAIL_ALSO=otro@ejemplo.com
RESEND_API_KEY=
REPORT_EMAIL_TO=

# Opción B: SendGrid (SMTP) – 100/día, Nodemailer
# ---------------------------------------------------------------------------
# SendGrid → API Keys → crear. Settings → Sender Authentication → Single Sender (verificar un email).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxx (tu API key)
# SMTP_SECURE=false
# REPORT_EMAIL_FROM=el-email-verificado@ejemplo.com

# Opción C: Gmail (SMTP) – entrega real, contraseña de aplicación
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tugmail@gmail.com
# SMTP_PASS=contraseña-de-app-16-chars
# SMTP_SECURE=false
# REPORT_EMAIL_FROM=tugmail@gmail.com

# Opción D: Brevo (API) – 300/día. REPORT_EMAIL_FROM = email cuenta Brevo.
# ---------------------------------------------------------------------------
# BREVO_API_KEY=
# REPORT_EMAIL_FROM=

# Opción E: Otro SMTP (Mailgun, etc.)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=tu-usuario
SMTP_PASS=tu-password
SMTP_SECURE=false
REPORT_EMAIL_FROM=reportes@tudominio.com

# Destino del reporte cuando llega por WhatsApp (webhook). Todos los reportes del demo van aquí.
REPORT_EMAIL_TO=destino@ejemplo.com

# ---------------------------------------------------------------------------
# WhatsApp (para cuando conectes Twilio o Meta al webhook)
# El webhook actual es POST /webhook/reporte; tú envías desde WhatsApp
# los datos al backend (ubicación, descripción, fotos, email).
# ---------------------------------------------------------------------------
# Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Business / Cloud API (verificación del webhook):
# WHATSAPP_VERIFY_TOKEN=tu-token-secreto
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# IA / asistente (Claude u otro: extraer texto de voz, mejorar descripción)
# ---------------------------------------------------------------------------
# Claude (Anthropic):
# ANTHROPIC_API_KEY=
